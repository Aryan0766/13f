{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "13F: Pick filer",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor",
      "args": [
        "--filer",
        "${input:pickFiler}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Run ALL filers",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor",
      "args": [
        "--all"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Other ticker or CIK",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor",
      "args": [
        "--filer",
        "${input:filer}",
        "--quarters",
        "${input:quarters}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Refresh tracker only",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor",
      "args": [
        "--tracker-only"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Stock lookup (funds holding)",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.bulk",
      "args": [
        "--lookup",
        "${input:lookupTicker}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Build bulk index",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.bulk",
      "args": [
        "--build"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Open as website (Chrome tab)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/src/thirteenf_processor/web.py",
        "--server.address",
        "localhost",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Combine all filers (one Excel)",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.combine",
      "args": [
        "--period",
        "${input:combinePeriod}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Market screener (biggest holder gainers)",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.bulk",
      "args": [
        "--screen"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Market screener EARLY look (quarter not complete)",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.bulk",
      "args": [
        "--screen",
        "--early"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Live fetch (newest quarter from EDGAR)",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.live",
      "args": [
        "--fetch"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "13F: Live vs SEC data set check",
      "type": "debugpy",
      "request": "launch",
      "module": "thirteenf_processor.live",
      "args": [
        "--compare"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
